{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "public/*.xml",
          "public/*.xsl",
          "public/*.txt",
          "public/*.json",
          "public/*.js",
          "public/*.ico",
          "templates/**"
        ]
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(BingSiteAuth.xml|bingsiteauth.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xsl",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xsl; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(feed.xml|rss.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(watch|shorts/.*|4youtube/.*|4/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "yt4mp3.com"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://www.yt4mp3.com/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.yt4mp3.cc"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://www.yt4mp3.com/$1"
      }
    },
    {
      "src": "/robots\\.text",
      "status": 301,
      "headers": {
        "Location": "/robots.txt"
      }
    },
    {
      "src": "/about/?",
      "status": 301,
      "headers": {
        "Location": "/contact-us#about"
      }
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/sitemap\\.xml",
      "has": [
        {
          "type": "host",
          "value": "yt4mp3.com"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://www.yt4mp3.com/sitemap.xml"
      }
    },
    {
      "src": "/sitemap.xml",
      "dest": "/public/sitemap.xml"
    },
    {
      "src": "/sitemap\\.xsl",
      "dest": "/public/sitemap.xsl"
    },
    {
      "src": "/llms.txt",
      "dest": "/public/llms.txt"
    },
    {
      "src": "/ads.txt",
      "dest": "/public/ads.txt"
    },
    {
      "src": "/manifest.json",
      "dest": "/public/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/public/sw.js"
    },
    {
      "src": "/(BingSiteAuth|bingsiteauth)\\.xml",
      "dest": "/public/BingSiteAuth.xml"
    },
    {
      "src": "/google7dfcf5b26cc1f483.html",
      "dest": "/public/google7dfcf5b26cc1f483.html"
    },
    {
      "src": "/8f9b3e1c4a2d7e5f9a0b1c2d3e4f5a6b.txt",
      "dest": "/public/8f9b3e1c4a2d7e5f9a0b1c2d3e4f5a6b.txt"
    },
    {
      "src": "/feed.xml",
      "dest": "/public/feed.xml"
    },
    {
      "src": "/rss.xml",
      "dest": "/public/feed.xml"
    },
    {
      "src": "/favicon\\.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/favicon\\.svg",
      "dest": "/public/favicon.svg"
    },
    {
      "src": "/static/(.*)",
      "dest": "/public/static/$1"
    },
    {
      "src": "/(index\\.html|index\\.php|home|home/|en|en/)",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/(youtube-to-mp3|youtube-to-mp4|youtube-shorts-downloader|contact-us|terms-of-service|privacy-policy|blog)/",
      "status": 301,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/blog/([a-z0-9-]+)/",
      "status": 301,
      "headers": {
        "Location": "/blog/$1"
      }
    },
    {
      "src": "/(ar|de|es|fr|hi|id|it|ja|ko|pt|ru|tr|vi|my)/blog",
      "status": 301,
      "headers": {
        "Location": "/$1/blog/"
      }
    },
    {
      "src": "/(ar|de|es|fr|hi|id|it|ja|ko|pt|ru|tr|vi|my)/blog/([a-z0-9-]+)/",
      "status": 301,
      "headers": {
        "Location": "/$1/blog/$2"
      }
    },
    {
      "src": "/(ar|de|es|fr|hi|id|it|ja|ko|pt|ru|tr|vi|my)/(youtube-to-mp3|youtube-to-mp4|youtube-shorts-downloader)/",
      "status": 301,
      "headers": {
        "Location": "/$1/$2"
      }
    },
    {
      "src": "/",
      "dest": "/public/pages/en/index.html"
    },
    {
      "src": "/blog",
      "dest": "/public/pages/en/blog.html"
    },
    {
      "src": "/blog/([a-z0-9-]+)",
      "dest": "/public/pages/en/blog/$1.html"
    },
    {
      "src": "/(youtube-to-mp3|youtube-to-mp4|youtube-shorts-downloader)",
      "dest": "/public/pages/en/$1.html"
    },
    {
      "src": "/(contact-us|terms-of-service|privacy-policy)",
      "dest": "/public/pages/legal/$1.html"
    },
    {
      "src": "/(ar|de|es|fr|hi|id|it|ja|ko|pt|ru|tr|vi|my)/",
      "dest": "/public/pages/$1/index.html"
    },
    {
      "src": "/(ar|de|es|fr|hi|id|it|ja|ko|pt|ru|tr|vi|my)/blog/",
      "dest": "/public/pages/$1/blog.html"
    },
    {
      "src": "/(ar|de|es|fr|hi|id|it|ja|ko|pt|ru|tr|vi|my)/blog/([a-z0-9-]+)",
      "dest": "/public/pages/$1/blog/$2.html"
    },
    {
      "src": "/(ar|de|es|fr|hi|id|it|ja|ko|pt|ru|tr|vi|my)/(youtube-to-mp3|youtube-to-mp4|youtube-shorts-downloader)",
      "dest": "/public/pages/$1/$2.html"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
